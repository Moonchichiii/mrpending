{
  "name": "mrpending",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "eval"
  ],
  "scripts": {
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint",
